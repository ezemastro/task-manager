# Configuración de Producción para Task Manager

# Puerto en el que se ejecutará la aplicación
PORT=3000

# Entorno de ejecución
NODE_ENV=production

# Ruta donde se guardará la base de datos
# En Docker se usa /app/data (montado como volumen)
# En desarrollo local puedes usar ./data
DB_PATH=/app/data

# JWT — REQUERIDO en producción. El servidor se niega a arrancar si falta,
# si vale el default conocido, o si tiene menos de 32 caracteres.
# Generar uno fuerte:    openssl rand -hex 64
# Setear en Coolify → Application → Environment Variables (per-app, NO en S3 Storage global).
JWT_SECRET=
JWT_EXPIRY=7d

# Configuración de CORS (opcional)
# CORS_ORIGIN=https://tu-dominio.com

# Límites de la aplicación (opcional)
# MAX_REQUEST_SIZE=10mb
# REQUEST_TIMEOUT=30000

# Configuración de email
RESEND_API_KEY=
FROM_EMAIL=onboarding@resend.dev
FROM_NAME=Gestión de Proyectos
APP_URL=http://localhost:3000

# ============================================================
# Backups a Cloudflare R2 (v1)
# ============================================================
# IMPORTANTE: estas variables van en el env POR-APP de Coolify,
# NO en el almacenamiento global S3 de Coolify (ese no se inyecta
# a los contenedores de la app). El bucket R2 ya debe existir.
#
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_BUCKET=task-manager-backups
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...
# R2_REGION=auto
# BACKUP_RETENTION_DAYS=7
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
BACKUP_RETENTION_DAYS=7